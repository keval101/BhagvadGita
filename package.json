{
  "name": "bhagvad-gita",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NODE_OPTIONS=--openssl-legacy-provider ng serve",
    "build": "NODE_OPTIONS=--openssl-legacy-provider ng build --prod",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider ng build --watch --configuration development",
    "test": "NODE_OPTIONS=--openssl-legacy-provider ng test",
    "dev:ssr": "NODE_OPTIONS=--openssl-legacy-provider ng run BhagvadGita:serve-ssr",
    "serve:ssr": "node dist/BhagvadGita/server/main.js",
    "build:ssr": "rm -rf dist && NODE_OPTIONS=--openssl-legacy-provider ng build && node scripts/prepare-vercel.js && NODE_OPTIONS=--openssl-legacy-provider ng run BhagvadGita:server",
    "prerender": "NODE_OPTIONS=--openssl-legacy-provider ng run BhagvadGita:prerender",
    "seo:audit": "node scripts/seo-audit.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^12.2.16",
    "@angular/common": "~12.2.0",
    "@angular/compiler": "~12.2.0",
    "@angular/core": "~12.2.0",
    "@angular/forms": "~12.2.0",
    "@angular/platform-browser": "~12.2.0",
    "@angular/platform-browser-dynamic": "~12.2.0",
    "@angular/platform-server": "~12.2.0",
    "@angular/router": "~12.2.0",
    "@nguniversal/express-engine": "^12.1.3",
    "express": "^4.15.2",
    "memory-cache": "^0.2.0",
    "ngx-pagination": "^5.1.1",
    "primeicons": "^5.0.0",
    "primeng": "^12.0.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.7",
    "@angular/cli": "~12.2.7",
    "@angular/compiler-cli": "~12.2.0",
    "@nguniversal/builders": "^12.1.3",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^12.20.55",
    "autoprefixer": "^10.4.2",
    "jasmine-core": "~3.8.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "postcss": "^8.4.6",
    "tailwindcss": "^2.2.19",
    "typescript": "~4.3.5"
  }
}
